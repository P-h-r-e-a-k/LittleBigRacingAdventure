<Window x:Class="LBRAInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Little Big Halloween Racing Adventure - Setup" Width="760" Height="480" MinWidth="620" MinHeight="470"
        WindowStartupLocation="CenterScreen" Background="#14101A" Foreground="#F2E6D8" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22,16,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Little Big" FontSize="18" Foreground="#C9B8E8" FontStyle="Italic"/>
            <TextBlock Text="HALLOWEEN RACING ADVENTURE" FontSize="30" FontWeight="Black" Foreground="{StaticResource Pumpkin}">
                <TextBlock.Effect><DropShadowEffect Color="#FF4A00" BlurRadius="18" ShadowDepth="0" Opacity="0.7"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#BFAFCB">
                A Halloween special: a race through LBA1's Temple of Bú, ported to LBA2's engine. The game is made from your own copies of
                Little Big Adventure and Little Big Adventure 2: choose their folders and a folder to install into. Their files are copied,
                never changed.
            </TextBlock>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Little Big Adventure" VerticalAlignment="Center"/>
            <TextBox x:Name="Lba1Box" Grid.Row="0" Grid.Column="1" Margin="0,4" ToolTip="The folder with LBA1's SCENE.HQR, LBA_GRI.HQR, LBA_BLL.HQR, LBA_BRK.HQR and RESS.HQR"/>
            <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Click="Browse_Click" Tag="Lba1Box"/>
            <TextBlock Grid.Row="1" Text="Little Big Adventure 2" VerticalAlignment="Center"/>
            <TextBox x:Name="Lba2Box" Grid.Row="1" Grid.Column="1" Margin="0,4" ToolTip="The folder with LBA2's RESS.HQR, SCENE.HQR and BODY.HQR"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Click="Browse_Click" Tag="Lba2Box"/>
            <TextBlock Grid.Row="2" Text="Install into" VerticalAlignment="Center"/>
            <TextBox x:Name="TargetBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Margin="8,4,0,4" Click="Browse_Click" Tag="TargetBox"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <CheckBox x:Name="ShortcutBox" Content="Put a shortcut on the desktop" IsChecked="True" Foreground="#F2E6D8"/>
            <ProgressBar x:Name="Progress" Height="10" Margin="0,10,0,0" Minimum="0" Maximum="1" Foreground="{StaticResource Pumpkin}" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"/>
            <TextBlock x:Name="Status" Margin="0,6,0,0" Foreground="#BFAFCB" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PlayButton" Content="Play" Margin="0,0,10,0" Click="Play_Click" IsEnabled="False"/>
            <Button x:Name="InstallButton" Content="Install" Click="Install_Click" Background="{StaticResource Ember}"/>
            <Button Content="Close" Margin="10,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
